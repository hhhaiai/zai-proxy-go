# === 基础配置 ===
PORT=8000
LOG_LEVEL=info

# === Token 管理配置 ===

# 静态Token列表（多个用逗号分隔，不要有空格）
# 示例: ZAI_STATIC_TOKENS=token1,token2,token3
ZAI_STATIC_TOKENS=

# 是否启用匿名Token（作为备用）
ZAI_ENABLE_ANONYMOUS=true

# 轮询策略
# round_robin - 顺序轮询（默认）
# random - 随机选择
# least_used - 使用次数最少优先
ZAI_STRATEGY=round_robin

# === 浏览器池配置 ===

# 浏览器会话池大小（默认2）
BROWSER_POOL_SIZE=2

# === 动态Token获取（可选）===

# 动态API地址（返回 {"token": "...", "expiry": 1234567890}）
ZAI_DYNAMIC_API=

# 动态API认证Token（如果需要）
ZAI_DYNAMIC_API_TOKEN=

# 动态获取间隔（分钟）
ZAI_DYNAMIC_INTERVAL=30

# === 健康检查 ===

# 是否启用健康检查
ZAI_ENABLE_HEALTH_CHECK=true

# 健康检查间隔（秒）
ZAI_HEALTH_CHECK_INTERVAL=60

# === 使用示例 ===

# 1. 基础多Token轮询
# ZAI_STATIC_TOKENS=token1,token2,token3,token4,token5

# 2. 混合模式（静态+动态+匿名）
# ZAI_STATIC_TOKENS=personal-token-1,personal-token-2
# ZAI_DYNAMIC_API=https://your-api.com/get-token
# ZAI_DYNAMIC_API_TOKEN=your-secret
# ZAI_ENABLE_ANONYMOUS=true
# ZAI_STRATEGY=least_used

# 3. 纯匿名模式（保持原版功能）
# ZAI_ENABLE_ANONYMOUS=true
# ZAI_STATIC_TOKENS=
